# Acme Corp Pipeline Studio: install settings. Copy to config.env and edit.
# Databricks CLI profile for the target workspace (run `databricks auth login --host <url> --profile <name>` first).
PROFILE=my-workspace
# Unity Catalog catalog to hold all demo schemas (created if you have rights; otherwise create it first in Catalog Explorer).
CATALOG=acme_demo
# Only if the catalog doesn't exist and your metastore has no default storage root (error
# UC_METASTORE_STORAGE_ROOT_URL_NOT_FOUND...): an abfss://, s3:// or gs:// path covered by an external location.
CATALOG_MANAGED_LOCATION=
# SQL warehouse id (serverless recommended): SQL Warehouses -> your warehouse -> Connection details.
WAREHOUSE_ID=
# Name of the Databricks App to create/update.
APP_NAME=acme-pipeline-studio
# Foundation model endpoint the app uses for the intake chat + planner (must exist in the workspace).
LLM_ENDPOINT=databricks-claude-sonnet-4-6
# Optional: an existing Genie Code insight id (genie_code/users/<uid>/scheduled_insights/<id>) to attach to the
# Genie Code job without the UI step. Leave blank and the installer prints the 1-minute UI step instead.
GENIE_CODE_CONFIG_ID=
# Optional: where Genie Code skills go. Workspace-wide needs admin; it falls back to your user folder.
SKILLS_DIR=/Workspace/.assistant/skills
